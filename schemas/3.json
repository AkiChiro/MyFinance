      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"txns\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"description\" TEXT NULL, \"wallet_id\" TEXT NOT NULL, \"wallet_to_id\" TEXT NULL, \"category\" TEXT NULL, \"timestamp\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"imported\" INTEGER NOT NULL DEFAULT 0 CHECK (\"imported\" IN (0, 1)), \"starred\" INTEGER NOT NULL DEFAULT 0 CHECK (\"starred\" IN (0, 1)), \"wallet_from_name\" TEXT NULL, \"wallet_to_name\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"affects_balance\" INTEGER NOT NULL DEFAULT 1 CHECK (\"affects_balance\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
